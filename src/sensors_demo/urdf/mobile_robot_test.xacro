<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">

  <xacro:property name="len" value="1.0"/>
  <xacro:property name="height" value="0.3"/>
  <xacro:property name="width" value="0.6"/>
  <xacro:property name="r" value="0.15"/>
  <xacro:property name="w" value="0.1"/>
  
  <xacro:property name="density" value="19816"/>

  <xacro:property name="chassis_m" value="${len * width * height * density}"/>
  <xacro:property name="wheel_m" value="${pi * r * r * w * density}"/>
  <xacro:property name="caster_m" value="${(4.0/3.0) * pi * r * r * r * density}"/>

  <xacro:property name="s1" value="${height/2 + r/2}"/> 
  <xacro:property name="s2" value="${2 * r}"/>
  <xacro:property name="s3" value="${width/2 + w/2}"/>
  <xacro:property name="s4" value="${2 * r}"/>

  <material name="grey">
    <color rgba="0.7 0.7 0.75 1.0"/>
  </material>
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>

<!--base-->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
      <geometry>
        <box size="${len} ${width} ${height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
      <geometry>
        <box size="${len} ${width} ${height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
      <mass value="${chassis_m}"/>
      <inertia ixx="${(chassis_m/12) * (height*height + width*width)}" ixy="0.0" ixz="0.0" 
               iyy="${(chassis_m/12) * (len*len + width*width)}" iyz="0.0" 
               izz="${(chassis_m/12) * (len*len + height*height)}"/>
    </inertial>
  </link>

<!--left_wheel-->

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${r}" length="${w}"/>
      </geometry>
      <material name="red"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${r}" length="${w}"/>
      </geometry>
      <origin rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="${wheel_m}"/>
      <inertia ixx="${(wheel_m/12) * (3*r*r + w*w)}" ixy="0.0" ixz="0.0" 
               iyy="${(wheel_m/12) * (3*r*r + w*w)}" iyz="0.0" 
               izz="${(wheel_m/2) * (r*r)}"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/> 
    <child link="left_wheel"/>
    <origin xyz="${-s2} ${s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

<!--right_wheel-->

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${r}" length="${w}"/>
      </geometry>
      <material name="red"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${r}" length="${w}"/>
      </geometry>
      <origin rpy="${pi/2} 0 0"/>
    </collision>
    <inertial>
      <mass value="${wheel_m}"/>
      <inertia ixx="${(wheel_m/12) * (3*r*r + w*w)}" ixy="0.0" ixz="0.0" 
               iyy="${(wheel_m/12) * (3*r*r + w*w)}" iyz="0.0" 
               izz="${(wheel_m/2) * (r*r)}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/> 
    <child link="right_wheel"/>
    <origin xyz="${-s2} ${-s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
<!--caster_wheel-->

  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${r}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${r}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_m}"/>
      <inertia ixx="${(2.0/5.0) * caster_m * (r*r)}" ixy="0.0" ixz="0.0" 
               iyy="${(2.0/5.0) * caster_m * (r*r)}" iyz="0.0" 
               izz="${(2.0/5.0) * caster_m * (r*r)}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${s4} 0 ${r}" rpy="0 0 0"/>
  </joint>

</robot>