<launch>
    <arg name="pkg_name" default="mobile_robot"/>
    <arg name="model_file" default="mobile_robot.xacro"/>
    <arg name="rviz_file" default="robot_config.rviz"/>

    <let name="robot_desc" 
         value="$(command 'xacro $(find-pkg-share $(var pkg_name))/model/$(var model_file)')"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(var robot_desc)"/>
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r empty.sdf"/>
    </include>

    <node pkg="ros_gz_sim" exec="create" 
          args="-topic robot_description -name PEKKA -z 0.5" 
          output="screen"/>

    <node pkg="ros_gz_bridge" exec="parameter_bridge" 
          args="/scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan
                /cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist
                /odom@nav_msgs/msg/Odometry[gz.msgs.Odometry
                /tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V" 
          output="screen"/>

    <node pkg="rviz2" exec="rviz2" output="screen"/>
</launch>